+// ---- Tinta (cmake/patches/merman-tinta-svg-to-png.patch) ----------------------
+
+/// Rasterizes a finished SVG to PNG with the PNG operation's renderer and
+/// fonts. Tinta passes merman's resvg-safe SVG with its math labels lifted
+/// in from the parity SVG, which the PNG operation cannot draw. Returns 0 on
+/// success; free the bytes with `tinta_merman_free_png`.
+///
+/// # Safety
+/// `svg` must point to `svg_len` readable bytes, `background` be null or a
+/// NUL-terminated string, and `out`/`out_len` be writable.
+#[cfg(feature = "png")]
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn tinta_merman_svg_to_png(
+    svg: *const u8,
+    svg_len: usize,
+    scale: f32,
+    background: *const std::ffi::c_char,
+    out: *mut *mut u8,
+    out_len: *mut usize,
+) -> i32 {
+    if svg.is_null() || out.is_null() || out_len.is_null() {
+        return 1;
+    }
+    let bytes = unsafe { std::slice::from_raw_parts(svg, svg_len) };
+    let Ok(text) = std::str::from_utf8(bytes) else {
+        return 2;
+    };
+    let Ok(session) = merman_render::environment::RenderEnvironment::deterministic().begin_session() else {
+        return 3;
+    };
+    let Ok(sealed) = merman_render::svg::finalize_resvg_svg(text, &session) else {
+        return 4;
+    };
+    let mut options = merman_export::RasterOptions::default();
+    options.scale = scale;
+    if !background.is_null() {
+        if let Ok(colour) = unsafe { std::ffi::CStr::from_ptr(background) }.to_str() {
+            if !colour.is_empty() {
+                options.background = Some(colour.to_string());
+            }
+        }
+    }
+    let Ok(png) = merman_export::svg_to_png(&sealed, &options) else {
+        return 5;
+    };
+    let mut boxed = png.into_boxed_slice();
+    unsafe {
+        *out_len = boxed.len();
+        *out = boxed.as_mut_ptr();
+    }
+    std::mem::forget(boxed);
+    0
+}
+
+/// Frees a PNG from `tinta_merman_svg_to_png`.
+///
+/// # Safety
+/// `data` and `len` must come from one successful call.
+#[cfg(feature = "png")]
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn tinta_merman_free_png(data: *mut u8, len: usize) {
+    if !data.is_null() {
+        drop(unsafe { Box::from_raw(std::ptr::slice_from_raw_parts_mut(data, len)) });
+    }
+}
