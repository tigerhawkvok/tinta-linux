+// ---- Tinta (cmake/patches/merman-tinta-text-width.patch) ---------------------
+
+/// One line's advance width in CSS px, measured by the host in the faces it
+/// draws labels with.
+#[cfg(feature = "svg")]
+pub type TintaTextWidthFn = std::sync::Arc<dyn Fn(&str, &merman::svg::TextStyle) -> f64 + Send + Sync>;
+
+#[cfg(feature = "svg")]
+static TINTA_TEXT_WIDTH: std::sync::RwLock<Option<TintaTextWidthFn>> = std::sync::RwLock::new(None);
+
+/// Installs (or, with `None`, removes) the host's line-width function. Render
+/// requests without a host text-measurement service then size labels with it
+/// under merman's own wrapping and line-height rules
+/// (`DeterministicTextMeasurer::with_width_callback`).
+#[cfg(feature = "svg")]
+pub fn tinta_set_text_width(width: Option<TintaTextWidthFn>) {
+    *TINTA_TEXT_WIDTH.write().unwrap_or_else(|poisoned| poisoned.into_inner()) = width;
+}
+
+#[cfg(feature = "svg")]
+pub(crate) fn tinta_text_width() -> Option<TintaTextWidthFn> {
+    TINTA_TEXT_WIDTH.read().unwrap_or_else(|poisoned| poisoned.into_inner()).clone()
+}
