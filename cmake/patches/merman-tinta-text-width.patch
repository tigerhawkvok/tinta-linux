+// ---- Tinta (cmake/patches/merman-tinta-text-width.patch) ---------------------
+
+/// Tinta's line-width callback. Strings are UTF-8 and not NUL-terminated;
+/// `size` is the font size in CSS px. Returns the line's advance width in CSS
+/// px, or a negative value to let merman estimate it.
+#[cfg(feature = "svg")]
+pub type TintaTextWidthCallback = unsafe extern "C" fn(
+    text: *const u8,
+    text_len: usize,
+    family: *const u8,
+    family_len: usize,
+    size: f64,
+    weight: *const u8,
+    weight_len: usize,
+    style: *const u8,
+    style_len: usize,
+    user_data: *mut std::ffi::c_void,
+) -> f64;
+
+/// Sizes every later render's labels with `callback` (null restores merman's
+/// estimates). `callback` may be called from any thread while a render runs.
+///
+/// # Safety
+/// `callback` must stay callable, and `user_data` valid for it, until it is
+/// replaced.
+#[cfg(feature = "svg")]
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn tinta_merman_set_text_width(
+    callback: Option<TintaTextWidthCallback>,
+    user_data: *mut std::ffi::c_void,
+) {
+    use merman::svg::TextMeasurer as _;
+    let width = callback.map(|callback| {
+        let user_data = user_data as usize;
+        let estimate = merman::svg::DeterministicTextMeasurer::default();
+        Arc::new(move |text: &str, style: &merman::svg::TextStyle| -> f64 {
+            let family = style.font_family.as_deref().unwrap_or("");
+            let weight = style.font_weight.as_deref().unwrap_or("");
+            let font_style = style.font_style.as_deref().unwrap_or("");
+            let width = unsafe {
+                callback(
+                    text.as_ptr(),
+                    text.len(),
+                    family.as_ptr(),
+                    family.len(),
+                    style.font_size,
+                    weight.as_ptr(),
+                    weight.len(),
+                    font_style.as_ptr(),
+                    font_style.len(),
+                    user_data as *mut std::ffi::c_void,
+                )
+            };
+            if width.is_finite() && width >= 0.0 {
+                width
+            } else {
+                estimate.measure_html_line_width_px(text, style)
+            }
+        }) as merman_bindings_core::TintaTextWidthFn
+    });
+    merman_bindings_core::tinta_set_text_width(width);
+}
